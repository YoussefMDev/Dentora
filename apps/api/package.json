{
  "name": "@dentora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @dentora/contracts",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace @dentora/contracts",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @dentora/contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dentora/contracts": "0.1.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vitest": "5.0.4"
  }
}
