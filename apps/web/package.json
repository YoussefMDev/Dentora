{
  "name": "@dentora/web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run build --workspace @dentora/contracts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build --workspace @dentora/contracts",
    "test": "ng test --watch=false",
    "pretypecheck": "npm run build --workspace @dentora/contracts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "private": true,
  "packageManager": "npm@10.8.1",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@dentora/contracts": "0.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "jsdom": "30.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "5.0.4"
  }
}
