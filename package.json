{
  "name": "dentora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @dentora/api",
    "dev:web": "npm run start --workspace @dentora/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tools.json",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "angular-eslint": "22.6.0",
    "@types/node": "24.19.2",
    "@playwright/test": "1.64.0",
    "concurrently": "9.2.5",
    "eslint": "10.12.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
